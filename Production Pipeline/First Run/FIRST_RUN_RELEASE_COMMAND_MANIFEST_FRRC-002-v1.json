ght!==0.25||x.physicalNormalized.centerX!==0.55||x.physicalNormalized.centerY!==0.875)throw Error('physical registration');if(x.forcedColorEvidence.keySequence!=='Shift+Tab -> Tab'||x.forcedColorEvidence.predecessor.identity!=='Return to Chapter I, Glass Meadow'||x.forcedColorEvidence.outlineWidth!=='3px'||x.forcedColorEvidence.outlineStyle!=='solid'||x.forcedColorEvidence.outlineColor!==x.forcedColorEvidence.systemHighlight||x.forcedColorEvidence.mediaQueryActive!==true)throw Error('forced color');if(JSON.stringify(x.focusOrder.dom)!==JSON.stringify(['primary','sixfold-weir','meadow-return-ridge'])||JSON.stringify(x.focusOrder.enabled)!==JSON.stringify(['sixfold-weir','LOOK AT','TALK TO','USE','Return to Chapter I, Glass Meadow']))throw Error('focus order')}for(const v of [...Object.values(s.focus),...Object.values(s.inputs),s.pba.narrow,s.pba.global,s.pba.mediaIdentity,s.pba.runtimeRequests])if(v!==true)throw Error('required false');if(!finite(s.pba.sixfoldActivationMs)||s.pba.sixfoldActivationMs>2)throw Error('activation');console.log(JSON.stringify({schema:s.schema,candidate:s.candidate,layouts:s.layouts.length,pass:true}))"

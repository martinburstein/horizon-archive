    "served-identity": {
      "id": "served-identity",
      "workdir": "horizon-archive-game",
      "command": [
        "powershell",
        "-NoProfile",
        "-Command",
        "Add-Type -AssemblyName System.Net.Http;$ErrorActionPreference='Stop';$client=[System.Net.Http.HttpClient]::new();try{$pairs=@(@{u='http://127.0.0.1:4173';d='dist'},@{u='http://127.0.0.1:4184';d='review-fixtures/td012-measured-horizon/dist'});foreach($p in $pairs){$root=$client.GetByteArrayAsync($p.u+'/').Result;$deep=$client.GetByteArrayAsync($p.u+'/deep/fallback').Result;$disk=[IO.File]::ReadAllBytes((Resolve-Path ($p.d+'/index.html')));if(-not [Linq.Enumerable]::SequenceEqual([byte[]]$root,[byte[]]$deep)-or -not [Linq.Enumerable]::SequenceEqual([byte[]]$root,[byte[]]$disk)){throw 'index identity mismatch'};foreach($f in Get-ChildItem ($p.d+'/assets') -File|Where-Object {$_.Extension -in '.js','.css'}){$served=$client.GetByteArrayAsync($p.u+'/assets/'+$f.Name).Result;$bytes=[IO.File]::ReadAllBytes($f.FullName);if(-not [Linq.Enumerable]::SequenceEqual([byte[]]$served,[byte[]]$bytes)){throw ('asset mismatch '+$f.Name)}}}}finally{$client.Dispose()}"
      ],
      "timeout_ms": 60000,
      "expected_exit": 0,
      "owner": "combat_engineer",
      "prerequisites": [
        "production-preview",
        "fixture-preview"
      ],
      "output_port_ownership": "read-only HTTP 127.0.0.1:4173 and :4184",
      "cleanup": "none"
    },

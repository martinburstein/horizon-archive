    "accepted_media_manifest_primitive": [
      "param([ValidateSet('create','verify')] [string]$Mode)",
      "$ErrorActionPreference='Stop'",
      "$repo=[IO.Path]::GetFullPath((Get-Location).Path).TrimEnd([IO.Path]::DirectorySeparatorChar)",
      "$releasePath=Join-Path $repo 'Production Pipeline/First Run/FIRST_RUN_RELEASE_COMMAND_MANIFEST_FRRC-003-v1.json'",
      "$manifestPath=Join-Path $repo 'Production Pipeline/First Run/FIRST_RUN_ACCEPTED_MEDIA_MANIFEST_FRAM-001-v1.json'",
      "$release=Get-Content -Raw -LiteralPath $releasePath | ConvertFrom-Json",
      "$paths=@($release.policy.accepted_media_literals)",
      "if($paths.Count -ne 17 -or @($paths|Select-Object -Unique).Count -ne 17){throw 'literal path set mismatch'}",
      "$entries=[Collections.Generic.List[object]]::new()",
      "$tuple=[IO.MemoryStream]::new()",
      "$total=[int64]0",
      "try {",
      "  for($i=0;$i -lt $paths.Count;$i++){",
      "    $relative=[string]$paths[$i]",
      "    if($relative.Contains('\\') -or [IO.Path]::IsPathRooted($relative)){throw 'non-POSIX or rooted literal'}",
      "    $cursor=$repo",
      "    foreach($part in $relative.Split('/')){",
      "      if([string]::IsNullOrWhiteSpace($part) -or $part -eq '.' -or $part -eq '..'){throw 'invalid literal component'}",
      "      $cursor=Join-Path $cursor $part",
      "      $attributes=[IO.File]::GetAttributes($cursor)",
      "      if(($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'reparse point rejected'}",
      "    }",
      "    $full=[IO.Path]::GetFullPath($cursor)",
      "    if(!$full.StartsWith($repo+[IO.Path]::DirectorySeparatorChar,[StringComparison]::OrdinalIgnoreCase)){throw 'out-of-root literal'}",
      "    $stream=[IO.FileStream]::new($full,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read,1048576,[IO.FileOptions]::SequentialScan)",
      "    try {",
      "      $beforeLength=$stream.Length",
      "      $beforeCreation=[IO.File]::GetCreationTimeUtc($full).Ticks",
      "      $beforeWrite=[IO.File]::GetLastWriteTimeUtc($full).Ticks",
      "      $sha=[Security.Cryptography.SHA256]::Create()",
      "      try {$digest=$sha.ComputeHash($stream)} finally {$sha.Dispose()}",
      "      $length=[int64]$stream.Position",
      "      $afterLength=$stream.Length",
      "      $afterCreation=[IO.File]::GetCreationTimeUtc($full).Ticks",
      "      $afterWrite=[IO.File]::GetLastWriteTimeUtc($full).Ticks",
      "      if($length -ne $beforeLength -or $afterLength -ne $beforeLength -or $afterCreation -ne $beforeCreation -or $afterWrite -ne $beforeWrite){throw 'file identity or length changed'}",
      "    } finally {$stream.Dispose()}",
      "    $hex=([Convert]::ToHexString($digest)).ToLowerInvariant()",
      "    $total+=$length",
      "    $entry=[ordered]@{ordinal=$i+1;path=$relative;byteLength=$length;sha256=$hex}",
      "    $entries.Add([pscustomobject]$entry)",
      "    $record=[Text.Encoding]::UTF8.GetBytes($relative+[char]0+$length.ToString([Globalization.CultureInfo]::InvariantCulture)+[char]0+$hex+[char]10)",
      "    $tuple.Write($record,0,$record.Length)",
      "  }",
      "  if($total -ne 37410731){throw ('accepted-media byte total mismatch: '+$total)}",
      "  $tuple.Position=0",
      "  $tupleSha=[Security.Cryptography.SHA256]::Create()",
      "  try {$entriesSha=([Convert]::ToHexString($tupleSha.ComputeHash($tuple))).ToLowerInvariant()} finally {$tupleSha.Dispose()}",
      "} finally {$tuple.Dispose()}",
      "$computed=[ordered]@{schema='horizon-archive.first-run.accepted-media-manifest/v1';workOrder='FRWO-005-v2';shell='FRSH-005-v1';releaseBaseline='a91763e28d488f31f8cf7d40ece0b2682246ba9b';candidateHead=$null;pathBase='repository-root';hashAlgorithm='SHA-256';hashEncoding='lowercase-hex';entries=@($entries);count=17;totalBytes=37410731;entriesSha256=$entriesSha}",
      "if($Mode -eq 'create'){",
      "  if(Test-Path -LiteralPath $manifestPath){throw 'manifest already exists'}",
      "  $head=(git rev-parse HEAD).Trim()",
      "  if($LASTEXITCODE -ne 0 -or $head -notmatch '^[0-9a-f]{40}$'){throw 'candidate HEAD unavailable'}",
      "  $computed.candidateHead=$head",
      "  $json=[pscustomobject]$computed|ConvertTo-Json -Depth 8",
      "  [IO.File]::WriteAllText($manifestPath,$json+[Environment]::NewLine,[Text.UTF8Encoding]::new($false))",
      "} else {",
      "  $stored=Get-Content -Raw -LiteralPath $manifestPath|ConvertFrom-Json",
      "  $computed.candidateHead=$stored.candidateHead",
      "  if($stored.candidateHead -notmatch '^[0-9a-f]{40}$'){throw 'stored candidateHead malformed'}",
      "  if((git cat-file -t $stored.candidateHead).Trim() -ne 'commit'){throw 'stored candidateHead absent'}",
      "  if(($stored|ConvertTo-Json -Depth 8 -Compress) -ne (([pscustomobject]$computed)|ConvertTo-Json -Depth 8 -Compress)){throw 'manifest tuple or semantic drift'}",
      "}",
      "[pscustomobject]@{mode=$Mode;count=17;totalBytes=$total;entriesSha256=$entriesSha;candidateHead=$computed.candidateHead}|ConvertTo-Json -Compress"
    ]

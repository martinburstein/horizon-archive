{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon-archive.local/schemas/bug-report.schema.json",
  "title": "Horizon Archive player-to-debugger bug report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bug_id",
    "run_id",
    "reported_at",
    "build_id",
    "severity",
    "checkpoint",
    "summary",
    "steps_to_reproduce",
    "expected",
    "actual",
    "reproducible",
    "status"
  ],
  "properties": {
    "bug_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "reported_at": { "type": "string", "format": "date-time" },
    "build_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["blocking", "major", "minor", "cosmetic"] },
    "checkpoint": { "type": "string", "minLength": 1 },
    "question_id": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "steps_to_reproduce": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": "string", "minLength": 1 },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reproducible": { "type": "boolean" },
    "status": { "enum": ["open", "diagnosing", "fixed_pending_retry", "verified", "wont_fix"] },
    "debugger_resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["root_cause", "changed_paths", "tests_run", "retry_from"],
      "properties": {
        "root_cause": { "type": "string", "minLength": 1 },
        "changed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tests_run": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "retry_from": { "type": "string", "minLength": 1 },
        "fixed_build_id": { "type": ["string", "null"] }
      }
    }
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "generated_at",
    "progression"
  ],
  "properties": {
    "progression": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "skill_name",
          "introduced",
          "practiced",
          "reinforced",
          "mastery_expected_by"
        ]
      }
    }
  }
}
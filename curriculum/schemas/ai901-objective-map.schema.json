  "required": [
    "generated_at",
    "exam",
    "authority",
    "status",
    "domains"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "title",
          "weight",
          "objectives"
        ]
      }
    }
  }
}